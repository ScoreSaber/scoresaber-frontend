# Copy this to the deployment secret store or production .env
# Blank values are intentional; do not commit filled production secrets

# Required
NODE_ENV=production
API_URL=
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_ARCVIEWER_URL=
NEXT_PUBLIC_LUDUS_URL=

# Optional

# Patreon API clients: https://www.patreon.com/portal/registration/register-clients
# Access token/campaign ID: your creator/API client details
HOME_NEWS_PATREON_ACCESS_TOKEN=
HOME_NEWS_PATREON_CAMPAIGN_ID=

# X developer portal: https://developer.x.com/en/portal/dashboard
# Bearer token: your app > Keys and tokens
HOME_NEWS_X_BEARER_TOKEN=

# Google Cloud API credentials: https://console.cloud.google.com/apis/credentials
HOME_NEWS_YOUTUBE_API_KEY=

# Defaults
# These are config defaults; uncomment only to override

## Debug
# DEBUG_REACT_SCAN=false
# DEBUG_BREAKPOINTS=false
# DEBUG_PAGE_BACKGROUND=false

## Home news
# HOME_NEWS_X_USERNAME=ScoreSaber
# HOME_NEWS_YOUTUBE_HANDLE=@ScoreSaberOfficial

## Internal backend-owned
VISITOR_RATE_LIMIT_SECRET=

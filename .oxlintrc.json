{
   "$schema": "./node_modules/oxlint/configuration_schema.json",
   "plugins": ["typescript", "unicorn", "oxc"],
   "ignorePatterns": [".next/**", "dist/**", "node_modules/**", "scoresaber-frontend-legacy/**"],
   "categories": {
      "correctness": "error"
   },
   "rules": {
      "@typescript-eslint/ban-ts-comment": "error",
      "@typescript-eslint/no-empty-object-type": "error",
      "@typescript-eslint/no-explicit-any": "error",
      "@typescript-eslint/no-namespace": "error",
      "@typescript-eslint/no-require-imports": "error",
      "no-unused-vars": [
         "error",
         {
            "argsIgnorePattern": "^_",
            "varsIgnorePattern": "^_"
         }
      ],
      "unicorn/no-null": "off"
   },
   "overrides": [
      {
         "files": ["src/modules/**/*.{ts,tsx}", "src/shared/**/*.{ts,tsx}"],
         "rules": {
            "no-restricted-imports": [
               "error",
               {
                  "patterns": [
                     {
                        "group": ["@/app/**"],
                        "message": "app is the route layer; modules and shared code must not import from it"
                     }
                  ]
               }
            ]
         }
      },
      {
         "files": ["src/shared/routing/index.ts"],
         "rules": {
            "no-restricted-imports": "off"
         }
      },
      {
         "files": ["src/modules/**/*.tsx", "src/shared/components/**/*.{ts,tsx}"],
         "rules": {
            "no-restricted-imports": [
               "error",
               {
                  "paths": [
                     {
                        "name": "@/app/_providers/page-background-provider",
                        "message": "page background orchestration belongs in the app layer"
                     },
                     {
                        "name": "@/shared/api/server-api",
                        "message": "server page data loading belongs in the app layer"
                     },
                     {
                        "name": "@/shared/metadata",
                        "message": "metadata construction belongs in the app layer"
                     },
                     {
                        "name": "next/headers",
                        "message": "request header and cookie access belongs in the app layer"
                     },
                     {
                        "name": "@/shared/result/api",
                        "importNames": ["pageApiData"],
                        "message": "pageApiData belongs in the app layer"
                     }
                  ]
               }
            ]
         }
      }
   ],
   "env": {
      "builtin": true
   }
}
